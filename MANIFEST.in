include LICENSE README.md requirements.txt run2.sh gr.sh prepare_gr_data.py .env.example .gitignore
recursive-include configs *.json
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
global-exclude *.py[cod]
prune runs
prune logs
prune input
prune results
prune workspace
global-exclude *.log *.jsonl *.sqlite *.sqlite3 *.db *.pt *.pth *.npy *.npz *.pkl
prune artifacts
prune calls
prune request-cache
